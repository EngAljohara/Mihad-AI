<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>
		<staticContent>
			<remove fileExtension=".json" />
			<remove fileExtension=".bin" />
			<mimeMap fileExtension=".json" mimeType="application/json" />
			<mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
		</staticContent>
	</system.webServer>
</configuration>
